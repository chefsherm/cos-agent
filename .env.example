# --- Candidate Collective platform ---
# Postgres (Neon / Vercel Postgres / Supabase). Holds the Vouch Graph.
DATABASE_URL=postgres://user:password@host:5432/candidate_collective
# Set to "disable" only for a local Postgres without SSL.
DATABASE_SSL=

# Secret for signing session cookies (any long random string).
AUTH_SECRET=change_me_to_a_long_random_string

# Claude API — powers the referrer-surfacing and reactivation engines.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ClickUp CRM spine. Reads from and writes to workspace 90141390262 ONLY.
# Workspace 9017065181 is hard-blocked in code and fails the build if referenced.
CLICKUP_API_TOKEN=your_clickup_api_token
CLICKUP_WORKSPACE_ID=90141390262
# The Contact Spine list to sync role postings into (optional).
CLICKUP_ROLE_LIST_ID=

NEXT_PUBLIC_URL=https://your-app.vercel.app

# --- Preserved CoS Agent (/cos) ---
RESEND_API_KEY=your_resend_api_key
BRIEF_EMAIL=your@email.com
CRON_SECRET=make_up_a_random_string
