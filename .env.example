ANTHROPIC_API_KEY=your_anthropic_api_key
RESEND_API_KEY=your_resend_api_key
BRIEF_EMAIL=your@email.com
CRON_SECRET=make_up_a_random_string

# Optional — where /onboard submissions go (defaults to BRIEF_EMAIL)
SUBMIT_EMAIL=founder@candidatecollective.com

# Optional — enables real SMS for vouch requests (/vouches). Without these,
# vouch requests still work via copy-link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
