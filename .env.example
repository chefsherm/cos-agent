ANTHROPIC_API_KEY=your_anthropic_api_key
RESEND_API_KEY=your_resend_api_key
BRIEF_EMAIL=your@email.com
CRON_SECRET=make_up_a_random_string

# Optional — where /onboard submissions go (defaults to BRIEF_EMAIL)
SUBMIT_EMAIL=founder@candidatecollective.com

# Optional — enables real SMS for vouch requests (/vouches). Without these,
# vouch requests still work via copy-link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Recommended in production — encrypts the vouch store at rest (AES-256-GCM).
# Any long random string. Generate one with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# CC AI CEO (/api/ceo, /api/ceo/authorize). Endpoints return 503 until set.
CEO_API_SECRET=
# Rollout stage 1–4. Stage 1 = read, organize, draft, digest only.
CEO_STAGE=1
# Kill switch. "true" halts all autonomous action.
CEO_PAUSED=false
# Signs action-bound authorization tokens. No key means every ALLOW becomes DENY.
CEO_SIGNING_KEY=
# ClickUp invariant. 9017065181 is always prohibited regardless of these.
CC_CLICKUP_WORKSPACE_ID=90141390262
CC_PROHIBITED_CLICKUP_WORKSPACE_IDS=9017065181
# Comma-separated ClickUp list IDs the AI CEO may write to. Empty means writes escalate.
# Set only after verifying each list in ClickUp. CC Open Loops is 901418025585.
CC_CLICKUP_ALLOWED_LIST_IDS=
# Postgres for the Action Ledger. Apply db/ledger.sql as owner, then connect as
# ceo_agent (INSERT/SELECT only). Unset means every external action fails closed.
CEO_LEDGER_DATABASE_URL=
